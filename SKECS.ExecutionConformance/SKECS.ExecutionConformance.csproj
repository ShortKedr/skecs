<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SKECS/SKECS.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(GaExecutionConformanceBundleDirectory)' != ''">
    <DefineConstants>$(DefineConstants);SKECS_EXECUTION_CONFORMANCE_GA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GaExecutionConformanceBundleDirectory)' == ''">
    <Compile Remove="GaExecutionConformance.cs;GaMovement.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(GaExecutionConformanceBundleDirectory)' != ''">
    <ProjectReference Include="../SKECS.GA.Backend.Vulkan/SKECS.GA.Backend.Vulkan.csproj" />
    <ProjectReference Include="../SKECS.GA.Backend.D3D12/SKECS.GA.Backend.D3D12.csproj" />
    <ProjectReference Include="../SKECS.Serialization/SKECS.Serialization.csproj" />
    <Compile Include="$(GaExecutionConformanceBundleDirectory)/ga-adapter.g.cs;$(GaExecutionConformanceBundleDirectory)/ga-row-codec.g.cs" />
  </ItemGroup>
</Project>
