<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="../tools/release/ExperimentalPackage.props" />
  <ItemGroup>
    <Content Include="EXPERIMENTAL_NOTICE.md" Link="wwwroot/EXPERIMENTAL_NOTICE.md" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeFrameworkVersion>8.0.34</RuntimeFrameworkVersion>
    <UseMonoRuntime>true</UseMonoRuntime>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- A SIMD module cannot select a fallback after a browser rejects it at load time. -->
    <WasmEnableSIMD>false</WasmEnableSIMD>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmccMaximumHeapSize>268435456</EmccMaximumHeapSize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunAOTCompilation)' != 'true'">
    <DefineConstants>$(DefineConstants);WEB_INTERPRETER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="wwwroot/licenses/MIT.txt" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(RuntimeFrameworkVersion)" />
    <ProjectReference Include="../SpaceBattle.Core/SpaceBattle.Core.csproj" />
    <ProjectReference Include="../SpaceBattle.Replay/SpaceBattle.Replay.csproj" />
    <ProjectReference Include="../SKECS.GA.Backend.WebGpu/SKECS.GA.Backend.WebGpu.csproj" />
    <Content Include="../SKECS.GA.Backend.WebGpu/ga-webgpu.mjs" Link="wwwroot/ga-webgpu.js" />
    <EmbeddedResource Include="Ga/Bundle/particle-expiry.*"
                      LogicalName="SpaceBattle.Web.Ga.Bundle.%(Filename)%(Extension)" />
    <Content Include="../SpaceBattle.Game/Assets/ships-atlas.png" Link="wwwroot/assets/ships-atlas.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/ships-atlas.json" Link="wwwroot/assets/ships-atlas.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/guns-atlas.png" Link="wwwroot/assets/guns-atlas.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/guns-atlas.json" Link="wwwroot/assets/guns-atlas.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/effects-atlas.png" Link="wwwroot/assets/effects-atlas.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/effects-atlas.json" Link="wwwroot/assets/effects-atlas.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/warp-atlas.png" Link="wwwroot/assets/warp-atlas.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/warp-atlas.json" Link="wwwroot/assets/warp-atlas.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceBattle.Game/Assets/PROVENANCE.md" Link="wwwroot/licenses/ARTWORK.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireMonoWebRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UseMonoRuntime)' != 'true' or '$(PublishReadyToRun)' != 'false'"
           Text="Space Battle Web supports Mono only. ReadyToRun is not a supported browser build." />
  </Target>
</Project>
