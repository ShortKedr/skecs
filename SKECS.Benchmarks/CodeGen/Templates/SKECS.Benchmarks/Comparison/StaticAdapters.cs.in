using System;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using FFS.Libraries.StaticEcs;
using SKECS.Benchmarks;
using BW = FFS.Libraries.StaticEcs.World<StaticBasicWorld>;
using SW = FFS.Libraries.StaticEcs.World<StaticStressWorld>;

readonly struct StaticBasicWorld : IWorldType { }
readonly struct StaticStressWorld : IWorldType { }

sealed class StaticWorkload : IWorkload
{
    private struct P : IComponent, IComponentConfig<P> { public float X, Y; public ComponentTypeConfig<P> Config() => new(noDataLifecycle: true); }
    private struct V : IComponent, IComponentConfig<V> { public float X, Y; public ComponentTypeConfig<V> Config() => new(noDataLifecycle: true); }
    private struct M : IComponent, IComponentConfig<M> { public float Value; public ComponentTypeConfig<M> Config() => new(noDataLifecycle: true); }
    private readonly BW.Entity[] entities;

    public StaticWorkload(int count)
    {
        entities = new BW.Entity[count];
        BW.Create(WorldConfig.Default());
        BW.Types().Component<P>();
        BW.Types().Component<V>();
        BW.Types().Component<M>();
        BW.Initialize();
    }
    public void Create()
    {
        BW.NewEntities<Default, P, V>((uint)entities.Length);
        var spawn = new Spawn { Entities = entities };
        BW.Query().Write<P, V>().For(ref spawn);
    }
    private struct Spawn : BW.IQuery.Write<P, V>
    {
        public BW.Entity[] Entities;
        public int Next;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public void Invoke(BW.Entity e, ref P p, ref V v)
        {
            var i = Next++;
            Entities[i] = e;
            p = new P { {{INITIAL_POSITION_2D}} };
            v = new V { {{INITIAL_VELOCITY_2D}} };
        }
    }
    public void Iterate() => BW.Query().Write<P>().Read<V>().For<Move>();
    private struct Move : BW.IQuery.Write<P>.Read<V>
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public void Invoke(BW.Entity e, ref P p, in V v) { {{MOVE p v XY}} }
    }
    public void Churn() => BW.Query().BatchSet(new M { Value = 10 }).BatchDelete<M>();
    public void Destroy() => BW.Query().BatchDestroy();
    public void Validate(int iterations, bool destroyed = false)
    {
        if (BW.Query<All<P, V>>().EntitiesCount() != (destroyed ? 0 : entities.Length))
            throw new InvalidOperationException("StaticEcs query count mismatch");
        for (int i = 0; i < entities.Length; i++)
        {
            var e = entities[i];
            if (e.IsNotDestroyed == destroyed) throw new InvalidOperationException("StaticEcs lifetime mismatch");
            if (destroyed) continue;
            ref var p = ref e.Ref<P>();
            ref var v = ref e.Ref<V>();
            if (p.X != i + iterations || p.Y != i - iterations || v.X != 1 || v.Y != -1 || e.Has<M>())
                throw new InvalidOperationException("StaticEcs component mismatch");
        }
    }
    public void Dispose() => BW.Destroy();
}

sealed class StaticStressBackend : IStressBackend
{
    private struct P : IComponent, IComponentConfig<P> { public StressPosition Value; public ComponentTypeConfig<P> Config() => new(noDataLifecycle: true); }
    private struct V : IComponent, IComponentConfig<V> { public StressVelocity Value; public ComponentTypeConfig<V> Config() => new(noDataLifecycle: true); }
    private struct Hot : IEntityType { public byte Id() => 1; }
{{TAGS
    private struct T$N : ITag { }
TAGS}}
    [StructLayout(LayoutKind.Explicit, Size = 256)]
    private struct Payload : IComponent, IComponentConfig<Payload> { [FieldOffset(0)] public StressPayload Value; public ComponentTypeConfig<Payload> Config() => new(noDataLifecycle: true); }
    private readonly SW.Entity[] entities;
    private readonly EntityGID[] retired;
    private readonly bool[] hasRetired;

    public StaticStressBackend(int count)
    {
        entities = new SW.Entity[count];
        retired = new EntityGID[count];
        hasRetired = new bool[count];
        SW.Create(WorldConfig.Default());
        SW.Types().Component<P>();
        SW.Types().Component<V>();
        SW.Types().EntityType<Hot>();
        SW.Types().Component<Payload>();
{{TAGS
        SW.Types().Tag<T$N>();
TAGS}}
        SW.Initialize();
        for (int i = 0; i < count; i++) entities[i] = Seed(i);
    }
    private static SW.Entity Seed(int i)
    {
        var e = (i % StressData.HotStride == 0 ? SW.NewEntity<Hot>() : SW.NewEntity<Default>()).Set(new P { Value = StressData.Position(i) }, new V { Value = StressData.Velocity });
        int shape = StressData.Shape(i);
{{TAGS
        if ((shape & $BIT) != 0) e.Set<T$N>();
TAGS}}
        return e;
    }
    public void MoveAll(bool hotOnly, bool wide)
    {
        if (wide)
        {
            if (hotOnly)
                SW.Query<EntityIs<Hot>>().Write<P, Payload>().Read<V>().For<MoveWide>();
            else
                SW.Query().Write<P, Payload>().Read<V>().For<MoveWide>();
        }
        else if (hotOnly)
            SW.Query<EntityIs<Hot>>().Write<P>().Read<V>().For<Move>();
        else
            SW.Query().Write<P>().Read<V>().For<Move>();
    }
    private struct Move : SW.IQuery.Write<P>.Read<V>
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public void Invoke(SW.Entity e, ref P p, in V v)
        { {{MOVE p.Value v.Value XYZ}} }
    }
    private struct MoveWide : SW.IQuery.Write<P, Payload>.Read<V>
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public void Invoke(SW.Entity e, ref P p, ref Payload b, in V v)
        {
            {{MOVE p.Value v.Value XYZ}}
            b.Value.Head++; b.Value.Tail++;
        }
    }
    public long ReadRandom(int[] indices)
    {
        long sum = 0;
        foreach (int i in indices)
        {
            ref var p = ref entities[i].Ref<P>().Value;
            sum += (long)p.X + p.Y + p.Z;
        }
        return sum;
    }
    public void AddPayload(int[] indices)
    {
        foreach (int i in indices) entities[i].Set(new Payload { Value = StressData.Payload(i) });
    }
    public void RemovePayload(int[] indices)
    {
        foreach (int i in indices) entities[i].Delete<Payload>();
    }
    public void Recycle(int[] indices)
    {
        foreach (int i in indices)
        {
            // Entity is a reusable slot ID; Gid captures its current generation.
            retired[i] = entities[i].GID;
            hasRetired[i] = true;
            entities[i].Destroy();
            entities[i] = Seed(i);
        }
    }
    public StressSnapshot Read(int logicalIndex)
    {
        var e = entities[logicalIndex];
        if (!e.IsNotDestroyed) return new StressSnapshot(0, 0, 0, false, false, 0, false, 0, 0);
        var p = e.Ref<P>().Value;
        int shape = 0;
{{TAGS
        if (e.Has<T$N>()) shape |= $BIT;
TAGS}}
        bool payload = e.Has<Payload>();
        var b = payload ? e.Ref<Payload>().Value : default;
        return new StressSnapshot(p.X, p.Y, p.Z, true, e.Is<Hot>(), shape, payload, b.Head, b.Tail);
    }
    public int Count(bool hotOnly) => hotOnly
        ? SW.Query<All<P, V>, EntityIs<Hot>>().EntitiesCount()
        : SW.Query<All<P, V>>().EntitiesCount();
    public void ValidateRetired()
    {
        for (int i = 0; i < retired.Length; i++)
            if (hasRetired[i] && retired[i].Status<StaticStressWorld>() == GIDStatus.Active)
                throw new InvalidOperationException("StaticEcs retired handle became alive");
    }
    public void Dispose() => SW.Destroy();
}
