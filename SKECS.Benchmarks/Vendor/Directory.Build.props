<Project>
  <PropertyGroup Condition="'$(ArtifactsPath)' == '' And '$(UseArtifactsOutput)' != 'true' And ('$(MSBuildProjectName)' == 'StaticLibrary' Or '$(MSBuildProjectName)' == 'MorpehLibrary')">
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
