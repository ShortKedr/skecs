<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationId>org.skecs.ga.movement</ApplicationId>
    <ApplicationTitle>SKECS GA Movement</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RunAOTCompilation>true</RunAOTCompilation>
    <UseInterpreter>false</UseInterpreter>
    <DynamicCodeSupport>false</DynamicCodeSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../SKECS.GA.Backend.Metal/SKECS.GA.Backend.Metal.csproj" />
    <Compile Include="../movement-conformance/MovementKernel.cs" Link="MovementKernel.cs" />
    <Compile Include="../movement-conformance/MovementFixture.cs" Link="MovementFixture.cs" />
    <Compile Include="$(VulkanBundle)/ga-adapter.g.cs" />
    <Compile Include="$(VulkanBundle)/ga-row-codec.g.cs" />
    <BundleResource Include="$(MetalBundle)/movement.manifest.json;$(MetalBundle)/movement.content-id;$(MetalBundle)/movement.metallib;$(MetalBundle)/movement.layout;$(MetalBundle)/movement.source-map.json"
                    LogicalName="bundle/%(Filename)%(Extension)" />
    <NativeReference Include="$(MetalFramework)" Kind="Framework" LinkToExecutable="false" />
  </ItemGroup>
  <Target Name="ValidateConformanceInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(VulkanBundle)' == '' Or !Exists('$(VulkanBundle)/ga-row-codec.g.cs') Or !Exists('$(VulkanBundle)/ga-adapter.g.cs')"
           Text="Set VulkanBundle to the validated Movement source bundle." />
    <Error Condition="'$(MetalBundle)' == '' Or !Exists('$(MetalBundle)/movement.metallib')"
           Text="Set MetalBundle to the iOS Movement package generated by Ga.MetalPackager." />
    <Error Condition="'$(MetalFramework)' == '' Or !Exists('$(MetalFramework)/ga-metal-native')"
           Text="Set MetalFramework to the arm64 ga-metal-native.framework built for iOS." />
    <Error Condition="'$(RuntimeIdentifier)' != 'ios-arm64' Or '$(RunAOTCompilation)' != 'true' Or '$(UseInterpreter)' != 'false' Or '$(MtouchInterpreter)' != '' Or '$(DynamicCodeSupport)' != 'false'"
           Text="The Movement conformance app requires the iOS arm64 device AOT profile with no interpreter." />
  </Target>
</Project>
