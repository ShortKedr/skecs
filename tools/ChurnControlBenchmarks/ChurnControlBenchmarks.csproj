<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(LegacyCore)' != 'true'">$(DefineConstants);CHURN_CONTROL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(SKECSCoreAssembly)' == ''" Include="../../SKECS/SKECS.csproj" />
    <Reference Condition="'$(SKECSCoreAssembly)' != ''" Include="SKECS" HintPath="$(SKECSCoreAssembly)" />
  </ItemGroup>
</Project>
