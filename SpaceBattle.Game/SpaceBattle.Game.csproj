<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../tools/release/ExperimentalPackage.props" />
  <ItemGroup>
    <None Update="EXPERIMENTAL_NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
