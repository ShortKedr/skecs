<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../tools/release/ExperimentalPackage.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>ShortKedr.SKECS.GA.Analyzers</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SKECS.GA.Compiler" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Update="buildTransitive/ShortKedr.SKECS.GA.Analyzers.props" Pack="true"
          PackagePath="buildTransitive/ShortKedr.SKECS.GA.Analyzers.props" />
  </ItemGroup>
</Project>
