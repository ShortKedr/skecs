<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625;CS8765</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Author's microbenchmark reference is preserved here; the generated,
         compiled integration lives in SKECS.Benchmarks/Comparison/StaticAdapters.cs. -->
    <Compile Remove="StaticAdapters.cs" />
    <ProjectReference Include="../SpaceBattle.Core/SpaceBattle.Core.csproj" />
    <ProjectReference Include="../SKECS.Benchmarks/Vendor/StaticLibrary.csproj" />
    <ProjectReference Include="../SKECS.Benchmarks/Vendor/MorpehLibrary.csproj" />
    <Compile Include="../SKECS.Benchmarks/Vendor/Sources/ecs/src/**/*.cs" Link="Vendor/Classic/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../SKECS.Benchmarks/Vendor/Sources/ecslite/src/**/*.cs" Link="Vendor/Lite/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
