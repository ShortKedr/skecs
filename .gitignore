# Build outputs
bin/
obj/

# IDE settings
.idea/
.vs/

# Benchmark outputs
BenchmarkDotNet.Artifacts/

# Temporary local research
_other_ecs_benchmarks/
/artifacts/

# Local tooling and repeatable verification outputs, never dependency sources
.dotnet/
.matplotlib-cache/
*.log
*.pdb
*.tmp
/progress.md
# Independent private repository for plans and internal documentation.
/secs-private/
/skecs-private/
# Unpublished security reviews belong in skecs-private/docs/security/.
/docs/security/
__pycache__/
*.pyc
/tools/web/node_modules/

# Generated benchmark inputs and raw exports are local artifacts, never documentation.
/docs/benchmarks/**/*.json
/docs/benchmarks/**/bdn-raw/
/docs/space-battle/current/*.json
/docs/space-battle/desktop-current/*.json
/docs/space-battle/**/*.ticks.csv.gz
/docs/space-battle/**/*.ticks.csv

# Publish only the pinned runtime source subsets and their original licenses.
# Keep all other upstream files locally, without distributing docs/assets/tools.
/SKECS.Benchmarks/Vendor/Sources/**
!/SKECS.Benchmarks/Vendor/Sources/ecs/
!/SKECS.Benchmarks/Vendor/Sources/ecslite/
!/SKECS.Benchmarks/Vendor/Sources/morpeh/
!/SKECS.Benchmarks/Vendor/Sources/StaticEcs/
!/SKECS.Benchmarks/Vendor/Sources/StaticPack/
!/SKECS.Benchmarks/Vendor/Sources/*/LICENSE.md
!/SKECS.Benchmarks/Vendor/Sources/ecs/src/
!/SKECS.Benchmarks/Vendor/Sources/ecs/src/*.cs
!/SKECS.Benchmarks/Vendor/Sources/ecslite/src/
!/SKECS.Benchmarks/Vendor/Sources/ecslite/src/*.cs
!/SKECS.Benchmarks/Vendor/Sources/morpeh/Scellecs.Morpeh/
!/SKECS.Benchmarks/Vendor/Sources/morpeh/Scellecs.Morpeh/Core/
!/SKECS.Benchmarks/Vendor/Sources/morpeh/Scellecs.Morpeh/Core/**/
!/SKECS.Benchmarks/Vendor/Sources/morpeh/Scellecs.Morpeh/Core/**/*.cs
!/SKECS.Benchmarks/Vendor/Sources/StaticEcs/Src/
!/SKECS.Benchmarks/Vendor/Sources/StaticEcs/Src/**/
!/SKECS.Benchmarks/Vendor/Sources/StaticEcs/Src/**/*.cs
!/SKECS.Benchmarks/Vendor/Sources/StaticPack/Src/
!/SKECS.Benchmarks/Vendor/Sources/StaticPack/Src/**/
!/SKECS.Benchmarks/Vendor/Sources/StaticPack/Src/**/*.cs

