# Generated benchmark inputs and raw exports are local artifacts, never documentation.
/Benchmarks.Local/*.json
!/Benchmarks.Local/vendor-manifest.json
/docs/benchmarks/**/*.json
/docs/benchmarks/**/bdn-raw/
/docs/space-battle/current/*.json
